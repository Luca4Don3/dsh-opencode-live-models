{
  "name": "dsh-opencode-live-models",
  "version": "0.11.3",
  "description": "Live model catalogs, native model selection, ChatGPT and OpenCode Console sign-in, subscription usage and Zen balances",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node probe.mjs && node --test test/*.test.mjs test/subscription/*.test.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luca4Don3/dsh-opencode-live-models.git"
  },
  "homepage": "https://github.com/Luca4Don3/dsh-opencode-live-models",
  "bugs": {
    "url": "https://github.com/Luca4Don3/dsh-opencode-live-models/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings-account",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "react": { "optional": true }
  }
}
